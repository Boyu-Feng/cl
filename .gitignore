# Local assets: keep directory markers only. Never commit weights, datasets or runs.
/models/*
!/models/.gitkeep
/data/*
!/data/.gitkeep
/results/*
!/results/.gitkeep
/migration/
/.local/
/ttcl/.runtime/

# Python/build/editor/cache files
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache/
.venv/
venv/
*.egg-info/
node_modules/
.DS_Store
.vscode/
*.log
*.out
*.pid
*.lock.tmp
*.partial

# Model/checkpoint binaries anywhere, including future experiments
*.safetensors
*.pt
*.pth
*.ckpt
*.onnx
*.gguf
pytorch_model*.bin
adapter_model*.bin

# Machine credentials; keep only explicit templates and the upstream empty test fixture
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
id_rsa*
id_ed25519*
mykey.py
!mykey_template.py
!mykey_template_en.py
